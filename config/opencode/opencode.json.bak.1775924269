{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "models": {
        "deepseek-coder:6.7b": {
          "_launch": true,
          "name": "deepseek-coder:6.7b"
        },
        "gpt-oss:20b": {
          "_launch": true,
          "name": "gpt-oss:20b"
        },
        "qwen2.5-coder:14b": {
          "_launch": true,
          "name": "qwen2.5-coder:14b"
        },
        "qwen3-coder:30b": {
          "_launch": true,
          "name": "qwen3-coder:30b"
        },
        "qwen3.5:9b": {
          "_launch": true,
          "name": "qwen3.5:9b"
        },
        "qwen3:14b": {
          "_launch": true,
          "name": "qwen3:14b"
        }
      },
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  }
}