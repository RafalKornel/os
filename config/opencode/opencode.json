{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "plan": {
      "color": "#e06c75" // red
    },
    "build": {
      "color": "#9d7cd8" // purple
    },
    "ask": {
      "color": "#5c9cf5" //blue
    }
  },
  "plugins": [
    "opencode-parser"
  ],
  "update": "disable",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "providers": {
    "llama.cpp": {
      "name": "llama.cpp (local)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:11435/v1"
      },
      "models": {
        "qwen3.6-35b": {},
        "qwen3.8-27b": {},
        "tiel-coder-35b": {}
      }
    },
    "ollama": {
      "name": "Ollama (local)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "ornith:9b": {},
        "ornith:35b": {},
        "gemma4:e2b": {},
        "gemma4:e4b": {},
        "gemma4:26b": {
          "name": "gemma4:26b (moe)"
        },
        "gemma4:31b": {},
        "qwen3.6:35b": {
          "name": "qwen3.6:35b (moe)"
        }
      }
    }
  }
}
