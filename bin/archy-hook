#!/bin/bash

# archy:summary=Run a named hook, like post-update (available in ~/.config/archy/hooks/post-update).
# archy:args=[name] [args...]

set -e

if (( $# < 1 )); then
  echo "Usage: archy-hook [name] [args...]"
  exit 1
fi

HOOK=$1
HOOK_PATH="$HOME/.config/archy/hooks/$1"
shift

if [[ -f $HOOK_PATH ]]; then
  bash "$HOOK_PATH" "$@"
fi
