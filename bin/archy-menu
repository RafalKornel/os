show_remove_elixir_menu() {
  case $(menu "Remove" "  Elixir\n  Phoenix") in
  *Elixir*) present_terminal "archy-remove-dev-env elixir" ;;
  *Phoenix*) present_terminal "archy-remove-dev-env phoenix" ;;
  *) show_remove_development_menu ;;
  esac
}

show_update_menu() {
  case $(menu "Update" "  Archy\n󰔫  Channel\n  Config\n󰸌  Extra Themes\n  Process\n󰇅  Hardware\n  Firmware\n  Password\n  Timezone\n  Time") in
  *Archy*) present_terminal archy-update ;;
  *Channel*) show_update_channel_menu ;;
  *Config*) show_update_config_menu ;;
  *Themes*) present_terminal archy-theme-update ;;
  *Process*) show_update_process_menu ;;
  *Hardware*) show_update_hardware_menu ;;
  *Firmware*) present_terminal archy-update-firmware ;;
  *Timezone*) present_terminal archy-tz-select ;;
  *Time*) present_terminal archy-update-time ;;
  *Password*) show_update_password_menu ;;
  *) show_main_menu ;;
  esac
}

show_update_channel_menu() {
  case $(menu "Update channel" "🟢 Stable\n🟡 RC\n🟠 Edge\n🔴 Dev") in
  *Stable*) present_terminal "archy-channel-set stable" ;;
  *RC*) present_terminal "archy-channel-set rc" ;;
  *Edge*) present_terminal "archy-channel-set edge" ;;
  *Dev*) present_terminal "archy-channel-set dev" ;;
  *) show_update_menu ;;
  esac
}
show_update_process_menu() {
  case $(menu "Restart" "  Hypridle\n  Hyprsunset\n󰎟  Mako\n  Swayosd\n󰌧  Walker\n󰍜  Waybar") in
  *Hypridle*) archy-restart-hypridle ;;
  *Hyprsunset*) archy-restart-hyprsunset ;;
  *Mako*) archy-restart-mako ;;
  *Swayosd*) archy-restart-swayosd ;;
  *Walker*) archy-restart-walker ;;
  *Waybar*) archy-restart-waybar ;;
  *) show_update_menu ;;
  esac
}

show_update_config_menu() {
  case $(menu "Use default config" "  Hyprland\n  Hypridle\n  Hyprlock\n  Hyprsunset\n󱣴  Plymouth\n  Swayosd\n  Tmux\n󰌧  Walker\n󰍜  Waybar") in
  *Hyprland*) present_terminal archy-refresh-hyprland ;;
  *Hypridle*) present_terminal archy-refresh-hypridle ;;
  *Hyprlock*) present_terminal archy-refresh-hyprlock ;;
  *Hyprsunset*) present_terminal archy-refresh-hyprsunset ;;
  *Plymouth*) present_terminal archy-refresh-plymouth ;;
  *Swayosd*) present_terminal archy-refresh-swayosd ;;
  *Tmux*) present_terminal archy-refresh-tmux ;;
  *Walker*) present_terminal archy-refresh-walker ;;
  *Waybar*) present_terminal archy-refresh-waybar ;;
  *) show_update_menu ;;
  esac
}

show_update_hardware_menu() {
  case $(menu "Restart" "  Audio\n󱚾  Wi-Fi\n󰂯  Bluetooth\n󰟸  Trackpad") in
  *Audio*) present_terminal archy-restart-pipewire ;;
  *Wi-Fi*) present_terminal archy-restart-wifi ;;
  *Bluetooth*) present_terminal archy-restart-bluetooth ;;
  *Trackpad*) present_terminal archy-restart-trackpad ;;
  *) show_update_menu ;;
  esac
}

show_update_password_menu() {
  case $(menu "Update Password" "  Drive Encryption\n  User") in
  *Drive*) present_terminal archy-drive-set-password ;;
  *User*) present_terminal passwd ;;
  *) show_update_menu ;;
  esac
}

show_about() {
  archy-launch-about
}

show_system_menu() {
  local options="󱄄  Screensaver\n  Lock"
  ! archy-toggle-enabled suspend-off && options="$options\n󰒲  Suspend"
  archy-hibernation-available && options="$options\n󰤁  Hibernate"
  options="$options\n󰍃  Logout\n󰜉  Restart\n󰐥  Shutdown"

  case $(menu "System" "$options") in
  *Screensaver*) archy-launch-screensaver force ;;
  *Lock*) archy-system-lock ;;
  *Suspend*) systemctl suspend ;;
  *Hibernate*) systemctl hibernate ;;
  *Logout*) archy-system-logout ;;
  *Restart*) archy-system-reboot ;;
  *Shutdown*) archy-system-shutdown ;;
  *) back_to show_main_menu ;;
  esac
}

show_main_menu() {
  go_to_menu "$(menu "Go" "󰀻  Apps\n󰧑  Learn\n󱓞  Trigger\n  Style\n  Setup\n󰉉  Install\n󰭌  Remove\n  Update\n  About\n  System")"
}

go_to_menu() {
  case "${1,,}" in
  *apps*) walker -p "Launch…" ;;
  *learn*) show_learn_menu ;;
  *trigger*) show_trigger_menu ;;
  *toggle*) show_toggle_menu ;;
  *hardware*) show_hardware_menu ;;
  *share*) show_share_menu ;;
  *background*) show_background_menu ;;
  *capture*) show_capture_menu ;;
  *style*) show_style_menu ;;
  *theme*) show_theme_menu ;;
  *screenrecord*) show_screenrecord_menu ;;
  *setup*) show_setup_menu ;;
  *power*) show_setup_power_menu ;;
  *install*) show_install_menu ;;
  *remove*) show_remove_menu ;;
  *update*) show_update_menu ;;
  *about*) show_about ;;
  *system*) show_system_menu ;;
  esac
}

# Allow user extensions and overrides
USER_EXTENSIONS="$HOME/.config/archy/extensions/menu.sh"
[[ -f $USER_EXTENSIONS ]] && source "$USER_EXTENSIONS"

toggle_existing_menu

if [[ -n $1 ]]; then
  BACK_TO_EXIT=true
  go_to_menu "$1"
else
  show_main_menu
fi
