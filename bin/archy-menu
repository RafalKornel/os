show_remove_menu() {
  case $(menu "Remove" "󰣇  Package\n  Web App\n  TUI\n󰵮  Development\n  Gaming\n󰏓  Preinstalls\n  Dictation\n󰸌  Theme\n󰍲  Windows\n󰈷  Fingerprint\n  Fido2") in
  *Package*) terminal archy-pkg-remove ;;
  *Web*) present_terminal archy-webapp-remove ;;
  *TUI*) present_terminal archy-tui-remove ;;
  *Development*) show_remove_development_menu ;;
  *Gaming*) show_remove_gaming_menu ;;
  *Preinstalls*) present_terminal archy-remove-preinstalls ;;
  *Dictation*) present_terminal archy-voxtype-remove ;;
  *Theme*) present_terminal archy-theme-remove ;;
  *Windows*) present_terminal "archy-windows-vm remove" ;;
  *Fingerprint*) present_terminal "archy-setup-fingerprint --remove" ;;
  *Fido2*) present_terminal "archy-setup-fido2 --remove" ;;
  *) show_main_menu ;;
  esac
}

