  *Elixir*) show_install_elixir_menu ;;
  *Zig*) present_terminal "archy-install-dev-env zig" ;;
  *Rust*) present_terminal "archy-install-dev-env rust" ;;
  *Java*) present_terminal "archy-install-dev-env java" ;;
  *NET*) present_terminal "archy-install-dev-env dotnet" ;;
