#!/bin/bash

# archy:summary=Set the branch for Archy's git repository.
# archy:args=<master|rc|dev>

if (($# == 0)); then
  echo "Usage: archy-branch-set [master|rc|dev]"
  exit 1
else
  branch="$1"
fi

if [[ $branch != "master" && $branch != "rc" && $branch != "dev" ]]; then
  echo "Error: Invalid branch '$branch'. Must be one of: master, rc, dev"
  exit 1
fi

git -C $ARCHY_PATH switch $branch
