#!/bin/bash

# archy:summary=Launch the Archy screensaver in the default terminal on the system with the correct font configuration.

if ! command -v tte &>/dev/null; then
  exit 1
fi

# Exit early if screensave is already running
pgrep -f org.archy.screensaver && exit 0

# Allow screensaver to be turned off but also force started
if archy-toggle-enabled screensaver-off && [[ $1 != "force" ]]; then
  exit 1
fi

# Silently quit Walker on overlay
walker -q

focused=$(archy-hyprland-monitor-focused)
terminal=$(xdg-terminal-exec --print-id)

for m in $(hyprctl monitors -j | jq -r '.[] | .name'); do
  hyprctl dispatch focusmonitor $m

  case $terminal in
  *Alacritty*)
    hyprctl dispatch exec -- \
      alacritty --class=org.archy.screensaver \
      --config-file ~/.local/share/archy/default/alacritty/screensaver.toml \
      -e archy-screensaver
    ;;
  *ghostty*)
    hyprctl dispatch exec -- \
      ghostty --class=org.archy.screensaver \
      --config-file=~/.local/share/archy/default/ghostty/screensaver \
      --font-size=18 \
      -e archy-screensaver
    ;;
  *kitty*)
    hyprctl dispatch exec -- \
      kitty --class=org.archy.screensaver \
      --override font_size=18 \
      --override window_padding_width=0 \
      -e archy-screensaver
    ;;
  *)
    notify-send -u low "✋  Screensaver only runs in Alacritty, Ghostty, or Kitty"
    ;;
  esac
done

hyprctl dispatch focusmonitor $focused
