#!/bin/bash

# archy:summary=Overwrite the user config for the Plymouth drive decryption and boot sequence with the Archy default and rebuild it.
# archy:requires-sudo=true

sudo cp -r ~/.local/share/archy/default/plymouth/* /usr/share/plymouth/themes/archy/
sudo plymouth-set-default-theme archy

if command -v limine-mkinitcpio &>/dev/null; then
  sudo limine-mkinitcpio
else
  sudo mkinitcpio -P
fi
