#!/bin/bash

# archy:summary=Set the Archy channel, which dictates what git branch and package repository is used.
# archy:args=<stable|rc|edge|dev>
# archy:requires-sudo=true

if (($# == 0)); then
  echo "Usage: archy-channel-set [stable|rc|edge|dev]"
  exit 1
else
  channel="$1"
fi

case "$channel" in
"stable") archy-branch-set "master" && archy-refresh-pacman "stable" ;;
"rc") archy-branch-set "rc" && archy-refresh-pacman "rc" ;;
"edge") archy-branch-set "master" && archy-refresh-pacman "edge" ;;
"dev") archy-branch-set "dev" && archy-refresh-pacman "edge" ;;
*) echo "Unknown channel: $channel"; exit 1; ;;
esac

archy-update -y
