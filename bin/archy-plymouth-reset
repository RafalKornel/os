#!/bin/bash

# archy:summary=Restore the default Archy Plymouth boot theme and SDDM login screen
# archy:requires-sudo=true

theme_dir="/usr/share/plymouth/themes/archy"

sudo find ~/.local/share/archy/default/plymouth -maxdepth 1 -type f -exec cp -t "$theme_dir/" {} +
sudo plymouth-set-default-theme archy

if archy-cmd-present limine-mkinitcpio; then
  sudo limine-mkinitcpio
else
  sudo mkinitcpio -P
fi

archy-refresh-sddm
