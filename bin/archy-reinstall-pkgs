#!/bin/bash

# archy:summary=Reinstall all default Archy packages from the stable channel
# archy:requires-sudo=true

set -e

# Reinstall all default Archy packages from the stable channel and downgrade any packages that are too new.

# Set the package repository to the stable mirrors
archy-refresh-pacman

# Downgrade any packages to the stable setup
sudo pacman -Suu --noconfirm

# Ensure all packages are installed
mapfile -t packages < <(grep -v '^#' "$ARCHY_PATH/install/archy-base.packages" | grep -v '^$')
sudo pacman -Syu --noconfirm --needed "${packages[@]}"
