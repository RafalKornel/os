#!/bin/bash

# archy:summary=Overwrite all the user configs in ~/.config/hypr with the Archy defaults.

archy-refresh-config hypr/autostart.conf
archy-refresh-config hypr/bindings.conf
archy-refresh-config hypr/input.conf
archy-refresh-config hypr/looknfeel.conf
archy-refresh-config hypr/hyprland.conf
archy-refresh-config hypr/monitors.conf
bash "$ARCHY_PATH/install/config/detect-keyboard-layout.sh"
